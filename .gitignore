# xschem/ngspice/magic
untitled*
*.log
*.ps
*.svg
*.raw
*.out
*.err
*.ext
*.drc
*.cif
*.spice
*.png
*.pdf
*.eps
*.csv

# Exception: Allow png/pdf/eps in doc directory
!doc/*.png
!doc/*.pdf
!doc/*.eps

# Loop-filter working files (notebook, PDF and its markdown rendering), not published
doc/pll-filter/

# Chipalooza items sent separately from the proposal (equipment, CVs), not published
doc/submission/

# Simulation directory
sim/*.txt
# Testbench netlists in sim/ are tracked; *.raw and *.log above stay ignored
!sim/**/*.spice
# netlists that failed scripts/netlist_check.py
sim/*.spice.bad
sim/*.spice.err

# General
*.bak*
*.tmp
*.swp
*.swo
*.save
*~
.venv

# Python cache
__pycache__/
*.pyc

# OS files
.DS_Store
Thumbs.db
