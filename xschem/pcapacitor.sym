v {xschem version=3.4.7 file_version=1.2
* Parasitic (simulation-only) capacitor, e.g. layout-extracted wiring C
* back-annotated into a schematic. Same as devices/capa.sym, plus
* lvs_ignore=open: netlisted normally, dropped when the tcl variable
* lvs_ignore is 1 (LVS netlists).
}
G {}
K {type=capacitor
format="@name @pinlist @value m=@m"
verilog_ignore=true
vhdl_ignore=true
tedax_ignore=true
lvs_ignore=open
template="name=CP1
m=1
value=1f"
}
V {}
S {}
E {}
L 4 0 5 0 30 {}
L 4 0 -30 0 -5 {}
L 4 -10 -5 10 -5 {}
L 4 -10 5 10 5 {}
L 4 2.5 -22.5 7.5 -22.5 {}
L 4 5 -25 5 -20 {}
B 5 -2.5 -32.5 2.5 -27.5 {name=p dir=inout pinnumber=1}
B 5 -2.5 27.5 2.5 32.5 {name=m dir=inout pinnumber=2}
T {@name} 15 -18.75 0 0 0.2 0.2 {}
T {@value} 15 -6.25 0 0 0.2 0.2 {}
T {m=@m} 15 6.25 0 0 0.2 0.2 {}
T {sim only} 15 18.75 0 0 0.15 0.15 {layer=8}
T {@#0:net_name} 10 -28.75 0 0 0.15 0.15 {layer=15 hide=instance}
T {@#1:net_name} 10 20 0 0 0.15 0.15 {layer=15 hide=instance}
