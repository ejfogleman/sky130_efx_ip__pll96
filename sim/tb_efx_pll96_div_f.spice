**.subckt tb_efx_pll96_div_f
xdut c4 c3 c2 c1 c0 clk q vdd GND efx_pll96_div_f
V1 clk GND 0 PULSE(0 {VDD} {TD_VCO} {T_RF} {T_RF} {T_VCO/2} {T_VCO})
C1 q 0 {CLOAD} m=1
V_VDD vdd GND {VDD}
.save i(v_vdd)
VC4 c4 GND {VC4}
VC3 c3 GND {VC3}
VC2 c2 GND {VC2}
VC1 c1 GND {VC1}
VC0 c0 GND {VC0}
**** begin user architecture code

* efx_pll96_div_f test
.lib ~/.ciel/sky130A/libs.tech/combined/sky130.lib.spice tt

*** efx_pll96_div_f code sweep
*** run from sim/ with:
*** ngspice -b -o tb_efx_pll96_div_f.out tb_efx_pll96_div_f.spice
*** Every code c[4:0] in cmin..cmax is run in turn; the .out file gets one
*** line per code: c, measured division ratio N (output period / clk period),
*** and average vdd current (N=0: output not toggling). All runs are written
*** to one .raw file.

*** simulation setup
.option temp=27
.param VDD=1.8
.param TD_VCO=2.5n
.param T_RF=100p
.param T_VCO=10.4167n
.param CLOAD=10f
*** code inputs (overwritten by the sweep below)
.param VC0=0 VC1=0 VC2=0 VC3=0 VC4=0



* lvdig standard cells (layout-extracted, C parasitics; symbols are primitives)
.include /home/ejf/Projects/sky130_efx_ip__pll96/dependencies/sky130_efx_ip__lvdig/spice/sky130_efx_lvdig_c.spice


* Run transient: sweep the division code
.options reltol=1e-4 vntol=1e-7 abstol=1e-13
.control
   set cmin = 0
   set cmax = 31
   set num_threads = 1
   set vdd = 1.8
   set appendwrite
   save clk q i(v_vdd)
   let c = $cmin
   set cc = $&c
   while $cc <= $cmax
      let c = $cc
      let b0 = c - 2*floor(c/2)
      let b1 = floor(c/2) - 2*floor(c/4)
      let b2 = floor(c/4) - 2*floor(c/8)
      let b3 = floor(c/8) - 2*floor(c/16)
      let b4 = floor(c/16) - 2*floor(c/32)
      let v0 = b0 * $vdd
      alter vc0 = $&v0
      let v1 = b1 * $vdd
      alter vc1 = $&v1
      let v2 = b2 * $vdd
      alter vc2 = $&v2
      let v3 = b3 * $vdd
      alter vc3 = $&v3
      let v4 = b4 * $vdd
      alter vc4 = $&v4
      tran 200p 3u
      let vth = $vdd/2
      let tq = 0
      meas tran tclk trig v(clk) val=$&vth rise=1 td=1u targ v(clk) val=$&vth rise=6 td=1u
      meas tran tq trig v(q) val=$&vth rise=1 td=1u targ v(q) val=$&vth rise=6 td=1u
      meas tran idd avg i(v_vdd) from=1u to=3u
      let n = tq/tclk
      echo DIVF c= $cc N= $&n idd= $&idd
      write tb_efx_pll96_div_f.raw
      let c = $cc + 1
      set cc = $&c
   end
.endc
.end

**** end user architecture code
**.ends

