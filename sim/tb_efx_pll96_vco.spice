**.subckt tb_efx_pll96_vco
V_VDD vdd GND {VDD}
C1 vcop 0 {CP} m=1
C2 vcon 0 {CP} m=1
V3 net1 GND {VC} PWL(0 0 1n {VC})
xvco vdd_vco vc vdd vcop vcon GND tst_lo tst_mid tst_hi efx_pll96_vco
V_VDD_VCO vdd_vco GND {VDD}
V42 tst_lo GND {VTLO}
V44 tst_mid GND {VTMID}
V46 tst_hi GND {VTHI}
R1 vc net1 {RC} m=1
**** begin user architecture code

* ejf_delaycell test
.lib ~/.ciel/sky130A/libs.tech/combined/sky130.lib.spice tt
.option temp=27
.param VDD=1.8
.param I_PULSE=1u
.param I_SRC=101u
.param CP=20f
.param VC=0.75
.param VTLO=0
.param VTMID=0
.param VTHI=0
.param RC=1



* Run transient
* default reltol=1e-3 vntol=1e-6 abstol=1e-12
.options  reltol=1e-6 vntol=1e-9 abstol=1e-15
.control
   save all
   tran 1n 300n
   write tb_efx_pll96_vco.raw
   plot vcop vcon
   meas tran i_v_vdd_avg avg i(v_vdd) from=10n to=100n
   meas tran i_v_vdd_vco_avg avg i(v_vdd_vco) from=10n to=100n
   meas tran vhi_avg avg xvco.vhi from=10n to=100n
   meas tran delta_t trig vcop val=0.5 rise=20 targ vcop val=0.5 rise=21
   print 1/delta_t
.endc
.end

**** end user architecture code
**.ends

