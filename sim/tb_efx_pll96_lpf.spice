**.subckt tb_efx_pll96_lpf
V38 csc GND {VCSC}
V_VDD_VCO vdd GND {VDD}
.save i(v_vdd_vco)
xlpf vdd vc GND csc rsc[0] rsc[1] vc2 efx_pll96_lpf
V_VC vc GND {VC} AC=1
.save i(v_vc)
V1 rsc[1] GND {VRSC1}
V3 rsc[0] GND {VRSC0}
* noconn vc2
**** begin user architecture code

* ejf_pfd test
.lib ~/.ciel/sky130A/libs.tech/combined/sky130.lib.spice tt
.option temp=27
.param VDD=1.8
.param VCSC=0
.param VRSC1=1.8
.param VRSC0=1.8
.param VC=0.9



* Run transient
* default reltol=1e-3 vntol=1e-6 abstol=1e-12
.options  reltol=1e-4 vntol=1e-7 abstol=1e-13
.control
   save all
   ac dec 10 1k 1g
   let i_mag = mag(i(v_vc))
   meas ac i_at_1k find i_mag at=1k
   print i_at_1k/6.283/1e3
   meas ac i_at_100meg find i_mag at=100meg
   print i_at_100meg/6.283/100e6
   write tb_efx_pll96_lpf.raw
.endc
.end

**** end user architecture code
