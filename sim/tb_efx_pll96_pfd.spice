**.subckt tb_efx_pll96_pfd
V_VDD vdd GND {VDD}
.save i(v_vdd)
V1 a GND 0 PULSE(0 {VDD} {TDA} {TRF} {TRF} {TA/2} {TA})
xpfd qref a qclk b vdd GND qref_b qclk_b efx_pll96_pfd
V2 b GND 0 PULSE(0 {VDD} {TDB} {TRF} {TRF} {TB/2} {TB})
xchp vdd qclk ibnp_1u qclk_b cp qref_b qref GND b1 en b2 b0 cp efx_pll96_chp
I0 ibnp_1u GND {IB}
V_VCP cp GND {VC}
.save i(v_vcp)
V5 b2 GND {VB2}
.save i(v5)
V6 b1 GND {VB1}
.save i(v6)
V8 en GND {VEN}
.save i(v8)
V3 b0 GND {VB0}
.save i(v3)
**** begin user architecture code

* ejf_pfd test
.lib ~/.ciel/sky130A/libs.tech/combined/sky130.lib.spice tt
.option temp=27
.param VDD=1.8
.param TA=200n
.param TDA=50n
.param TB=201n
.param TDB=46n
.param TRF=300p
.param CP=10f
.param VC=0.8
.param IB=1u
.param VB2=1.8
.param VB1=0
.param VB0=1.8
.param VEN=1.8



* lvdig standard cells (layout-extracted, C parasitics; symbols are primitives)
.include /home/ejf/Projects/sky130_efx_ip__pll96/dependencies/sky130_efx_ip__lvdig/spice/sky130_efx_lvdig_c.spice


* Run transient
* default reltol=1e-3 vntol=1e-6 abstol=1e-12
.options  reltol=1e-4 vntol=1e-7 abstol=1e-13
.options  method=gear
.control
   save all
   tran 1n 2u
   write tb_efx_pll96_pfd.raw
   meas tran i_v_vdd_avg avg i(v_vdd) from=0n to=2u
   plot i(v_vcp)
   plot qref qclk+2
.endc
.end

