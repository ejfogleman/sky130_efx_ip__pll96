**.subckt tb_efx_pll96_chp
V_VDD vdd GND {VDD} AC=1
.save i(v_vdd)
xchp vdd p ibnp_1u p_b cp n_b n GND b[1] en b[2] b[0] cp efx_pll96_chp
I0 ibnp_1u GND {IB}
V_VCP net1 GND {VC}
.save i(v_vcp)
V1 p GND {VDD}
.save i(v1)
V2 p_b GND 0
.save i(v2)
V3 n GND {VDD}
.save i(v3)
V4 n_b GND 0
.save i(v4)
R1 net1 cp 1 noise=0 m=1
V5 b[2] GND {VB2}
.save i(v5)
V6 b[0] GND {VB0}
.save i(v6)
V8 en GND {VEN}
.save i(v8)
V9 b[1] GND {VB1}
.save i(v9)
